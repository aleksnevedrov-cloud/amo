# «Агент опт»: скопируйте в /opt/agent-opt/.env и заполните. Сам .env не коммитится, этот образец — в репозитории.
# Переменные читают opt-api и opt-worker через общий загрузчик @core/shared (packages/core/shared/src/env.ts),
# «ОБЯЗАТЕЛЬНО» — без значения процесс не стартует (preflight.sh проверяет, что они непустые).

NODE_ENV=production
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Хост внутри контейнера; менять не нужно
API_HOST=0.0.0.0
# ОБЯЗАТЕЛЬНО. Порт opt-api — и внутри контейнера, и на хосте (docker-compose пробрасывает ${API_PORT}:${API_PORT}); наружу — nginx на opt.rf-dveri.ru
API_PORT=3001
# ОБЯЗАТЕЛЬНО. Публичный HTTPS-адрес опта. Redirect URI интеграции = PUBLIC_URL + /oauth/amo/callback
PUBLIC_URL=https://opt.rf-dveri.ru

# ОБЯЗАТЕЛЬНО. Сеть розничного compose-проекта, где живут postgres и redis (docker network ls)
RETAIL_NETWORK=src_default
# ОБЯЗАТЕЛЬНО. Своя БД и свой пользователь на том же Postgres (scripts/opt/create-db.sh); пароль — тот же, что OPT_DB_PASSWORD
DATABASE_URL=postgres://aidoor_opt:<пароль>@postgres:5432/ai_door_opt
# ОБЯЗАТЕЛЬНО. Redis розницы, база 1 (у розницы база 0)
REDIS_URL=redis://redis:6379/1

# ОБЯЗАТЕЛЬНО. ОТДЕЛЬНАЯ интеграция amoCRM для опта (карточка интеграции → «Ключи и доступы»): ID интеграции (UUID)
# и секретный ключ. Ключи розницы не подходят: два сервиса не могут обновлять один refresh-токен.
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
# Домены аккаунтов amo, куда можно отправлять client_secret; менять не нужно
AMO_ALLOWED_DOMAINS=amocrm.ru,amocrm.com,kommo.com

# ОБЯЗАТЕЛЬНО. Ключ шифрования токенов и паролей в БД: 32 байта в hex (openssl rand -hex 32). Свой, не копия розничного.
TOKEN_ENCRYPTION_KEY=
# Обновлять access-токен amo, если до истечения осталось меньше N секунд
TOKEN_REFRESH_MARGIN_SEC=21600

# Серверные ключи провайдеров LLM (необязательно): без них ключ вводится во вкладке «Модель» виджета опта
# или переносится из розницы скриптом migrate-kp-data.sh (шаг 7 плана)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OCR сканов и фото в спецификациях (необязательно): Yandex Vision; пусто — Tesseract внутри контейнера.
# YANDEX_SPEECHKIT_API_KEY — запасной ключ того же сервисного аккаунта, если VISION не задан
YANDEX_VISION_API_KEY=
YANDEX_SPEECHKIT_API_KEY=
YANDEX_FOLDER_ID=

# Через сколько дней после отключения интеграции удалять данные аккаунта
PURGE_UNINSTALLED_AFTER_DAYS=30

# Алерты в Telegram (необязательно)
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Задаются в Dockerfile.opt, в .env не нужны: MIGRATIONS_DIR=/app/migrations, KP_FILES_ROOT=/data (том opt_data).
# Пароль SMTP для отправки КП в .env НЕ хранится — вводится во вкладке «Письмо» виджета опта (поле «Пароль SMTP»).
