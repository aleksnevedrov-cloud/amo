# Скопируйте в .env и заполните. .env не коммитится.
NODE_ENV=production
LOG_LEVEL=info

API_PORT=3000
# Публичный HTTPS-адрес бэкенда. Redirect URI интеграции = PUBLIC_URL + /oauth/amo/callback
PUBLIC_URL=https://ai-agent.example.ru

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://aidoor:change-me@postgres:5432/aidoor
REDIS_URL=redis://redis:6379

# Из карточки интеграции amoCRM → «Ключи и доступы». Вносит заказчик.
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_ALLOWED_DOMAINS=amocrm.ru,amocrm.com,kommo.com

# 32 байта в hex: openssl rand -hex 32. При потере ключа токены придётся получить заново.
TOKEN_ENCRYPTION_KEY=
# Обновлять access-токен за 6 часов до истечения
TOKEN_REFRESH_MARGIN_SEC=21600

# Алерты в Telegram (необязательно)
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
