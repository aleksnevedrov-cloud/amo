# Шаблон .env для /opt/rf-messenger. Реальные значения — только в .env на сервере, не в git.

PUBLIC_URL=https://chat.rf-dveri.ru
API_PORT=3100
LOG_LEVEL=info
POSTGRES_PASSWORD=
# DATABASE_URL и REDIS_URL задаёт docker-compose.yml.

# Интеграция amoCRM с виджетом «РФ-Мессенджер» (отдельная от интеграции AI-агента).
# Ссылка для перенаправления в интеграции: https://chat.rf-dveri.ru/
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
# id аккаунта aleksnevedrov.amocrm.ru — обязателен в production, иначе сервис не стартует.
AMO_ACCOUNT_IDS=

# Канал API чатов — выдаёт техподдержка amoCRM по заявке (docs/amocrm-channel-request.md).
AMOJO_CHANNEL_ID=
AMOJO_CHANNEL_SECRET=
AMOJO_CHANNEL_TITLE=РФ-Мессенджер

# openssl rand -hex 32
ENCRYPTION_KEY=
# openssl rand -hex 32
FILE_URL_SECRET=
FILE_URL_TTL_DAYS=30
MAX_FILE_MB=50

OUTBOUND_PAUSE_MIN_MS=1000
OUTBOUND_PAUSE_MAX_MS=3000

# HTTP(S)-прокси для Telegram и WhatsApp: http://логин:пароль@хост:порт. Пусто — напрямую.
# amoCRM, postgres, redis всегда напрямую. В журналах логин и пароль маскируются.
MESSENGER_PROXY_URL=
# Запасной прокси (необязательно): включается после 3 неудачных проверок основного подряд,
# обратно на основной — после 3 удачных. Пусто — без запасного.
MESSENGER_PROXY_URL_FALLBACK=

# Уведомления в Telegram о сбоях прокси и каналов (необязательно, задаются вместе).
# Токен бота от @BotFather и id чата, куда писать. Пусто — без уведомлений.
ALERT_TG_BOT_TOKEN=
ALERT_TG_CHAT_ID=
