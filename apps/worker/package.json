{
  "name": "@ai-door/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "node ../../scripts/build-app.mjs src/main.ts dist/main.js && node ../../scripts/build-app.mjs src/calls-backfill.ts dist/calls-backfill.js && node ../../scripts/build-app.mjs src/calls-inspect.ts dist/calls-inspect.js && node ../../scripts/build-app.mjs src/calls-demo.ts dist/calls-demo.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@retail/agent": "workspace:*",
    "@core/amo": "workspace:*",
    "@core/calls": "workspace:*",
    "@retail/catalog": "workspace:*",
    "@core/db": "workspace:*",
    "@core/docs": "workspace:*",
    "@retail/knowledge": "workspace:*",
    "@core/llm": "workspace:*",
    "@retail/mail": "workspace:*",
    "@core/media": "workspace:*",
    "@retail/pricing": "workspace:*",
    "@core/shared": "workspace:*",
    "@core/tools": "workspace:*",
    "@anthropic-ai/sdk": "^0.128.0",
    "bullmq": "^5.81.5",
    "imapflow": "^2.0.6",
    "ioredis": "^5.11.1",
    "mailparser": "^3.9.28",
    "mammoth": "^1.12.3",
    "nodemailer": "^10.0.10",
    "openai": "^7.23.0",
    "pino": "^9.14.0",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1"
  }
}
